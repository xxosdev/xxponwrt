# ============================================================================
# 自定义增量配置 —— PonWrt 多机型版
#
# 本文件用 kconfig.pl 叠加在官方 configs/an7581.config 之上（后者覆盖前者），
# 官方配置随上游更新，你只需要维护这一个文件。
#
# 编译目标：4 台机器，全部是 airoha/an7581 平台
#    1. FiberHome HG5382A        (中国电信版魔百盒)
#    2. FiberHome HG5585F CT     (中国电信)
#    3. FiberHome HG5585F CU     (中国联通)
#    4. Nokia XG-040G-MD UBI     (贝曼/linksys 代工)
#
# ⚠ Nokia XG-040G-MF 是 AN7583 平台，不属于这个文件，需要另配一份 an7583 的配置，
#   目前暂不编译。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. 设备选择
#
#    官方 an7581.config 默认勾选了全部 9 台设备。每台都要单独打一份 rootfs，
#    编译时间几乎线性增长，所以必须逐条把不需要的写成 "is not set"。
#
#    注意官方配置里它们是 =y，只写 "#CONFIG_xxx is not set" 才是有效覆盖，
#    直接注释掉（#CONFIG_xxx）是不生效的。
#
#    保留的 4 台 vs 关闭的 5 台：
# ---------------------------------------------------------------------------
# —— 保留（这 4 台会各产出一个 sysupgrade.itb）——
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# —— 关闭 ——
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xg2010g is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_unionman_ung00a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d is not set


# ---------------------------------------------------------------------------
# 2. PON 组件（光猫能不能注册上线，全看这一段）
#
#    ★★ 这一段是整个配置最关键的部分，缺一样刷完就是块砖 ★★
#
#    -- userspace feed (pbs05/openwrt-pon-userspace) --
#      airoha-pond       OMCI + OAM 协议代理。没有它 PON 注册不了，等于没网
#      airoha-ponctl     线路配置与状态查询（ponctl 命令）
#      airoha-pon-debug  诊断采集
#      luci-app-pon      LuCI 页面：状态 / 配置 / 硬件身份 / 诊断
#      ⚠ 源码目录叫 airoha-pon-daemons，但产出包叫 airoha-pond，别写错
#
#    -- drivers feed (pbs05/openwrt-pon-drivers) --
#      kmod-airoha-xpon          PON MAC 核心
#      kmod-airoha-pon-frontend  frontend 抽象层（下面两个 kmod 的依赖）
#      kmod-airoha-en7572        EN7572 光模块驱动
#      kmod-airoha-paged-bosa    GN28L95 / UX3363 / 烽火 BOSA 驱动
#
#    ★★ 为什么两个 frontend 都要 =y ★★
#    官方配置把这俩都设成 =m（只产出 apk、不进固件），但每台的 DTS 只匹配其中一个：
#      target/linux/airoha/dts/an7581-fiberhome-hg5382a.dts     → fiberhome,hg5x-bosa / airoha,paged-bosa
#      target/linux/airoha/dts/an7581-fiberhome-hg5585f-common.dtsi → 同上（paged-bosa）
#      target/linux/airoha/dts/an7581-nokia_xg-040g-md-common.dtsi  → airoha,en7572
#    也就是说：烽火 3 台吃 paged-bosa，Nokia MD 吃 en7572。
#    两者都进固件会多占几百 KB，换来的是 4 台机用过同一份固件刷完就能起来，
#    不用每台单独 apk add 折腾。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y

CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y


# ---------------------------------------------------------------------------
# 3. IPTV
#    来自 pon_userspace feed（feeds.conf.default 第 7 行），官方配置默认是关闭的，
#    需要显式打开。功能是把某个 LAN 口划给机顶盒专用，在 pon0 上建 802.1q 子接口。
#
#    注意：luci-app-iptv 默认 enabled=0，刷完要在「网络 → IPTV」里手动启用，
#    并填你当地运营商的 IPTV 业务 VLAN ID。这几个 VLAN ID 问运营商，填错没信号。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y


# ---------------------------------------------------------------------------
# 4. 文件管理器
#
#    选用 luci-app-filemanager（ImmortalWrt 官方 luci feed 自带），替代 quickfile。
#    理由：quickfile 的 LUCI_DEPENDS 是 "+luci-nginx +quickfile"，强依赖 nginx，
#          必须把默认的 uhttpd 换成 nginx，且作者自己都标注了「非开发人员不建议自行编译」。
#          luci-app-filemanager 的 LUCI_DEPENDS 只有 "+luci-base"，
#          零额外依赖、跑在默认 uhttpd 上，不动基本框架。
#    能力：浏览/上传/下载/重命名/删除/权限修改，内置十六进制编辑器(HexEditor)，
#          走 rpcd ACL 授权，自带简体中文。
#    位置：LuCI 菜单「系统 → 文件管理器」
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y


# ---------------------------------------------------------------------------
# 5. EasyTier（异地组网 / 内网穿透）
#    来源：https://github.com/EasyTier/luci-app-easytier （第三方，本地 CI 拉取）
#
#    实际是两个包，必须成对出现：
#      easytier            核心程序。它是下载预编译二进制（不是本地编译），
#                          从 EasyTier/EasyTier 的 Release 拉 zip，所以很快
#      luci-app-easytier   LuCI 界面（Lua1 架构）
#
#    依赖说明（很重要）：
#      +kmod-tun   TUN/TAP 虚拟网卡，组网必需的，官方 packages feed 里有
#      +luci-compat  LuCI 老版 Lua 兼容层。OpenWrt 上游已经删掉了它，
#                    但 ImmortalWrt 还保留着（在 luci feed 的 modules/luci-compat），
#                    它会连带引入 luci-lua-runtime。本固件基于 ImmortalWrt，所以可用。
#
#    下面把 Web Console 关掉：那是自建控制台用的嵌入式 web 服务，体积不小，
#    一般组网用不到。需要的话把这一行注释删掉即可。
#    中文界面已包含（这个仓库的 po/zh_Hans 里有完整简体中文翻译）。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci-compat=y
# CONFIG_EASYTIER_INCLUDE_WEBCONSOLE is not set


# ---------------------------------------------------------------------------
# 6. ttyd 网页终端
#    官方 feeds 里就有（packages feed 的 ttyd + luci feed 的 luci-app-ttyd），
#    两者默认都是关闭的，这里打开。ttyd 自带 http 服务，不依赖 nginx。
#    两套配置建议一起开：luci-app-ttyd 是 LuCI 菜单入口，ttyd 是实际服务程序。
#    位置：LuCI 菜单「系统 → 终端」，有完整简体中文。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y


# ---------------------------------------------------------------------------
# 7. NPU / SoC 状态监控
#    来源：https://github.com/rchen14b/luci-app-airoha-npu （第三方，本地 CI 拉取）
#    LUCI_DEPENDS 是 "+luci-base @TARGET_airoha"，专为这块 SoC 写的，零额外依赖。
#
#    能看什么：NPU 卸载引擎状态、reserved memory、CPU 频率与调度器、
#              PPE 流表、Frame Engine 端口计数、WiFi 各频段队列。
#              还能直接调 PLL 超频（500-1600MHz）。
#
#    ⚠ 这个页面目前只有西班牙语翻译（仓库 po/ 目录下只有 es 和 templates），
#      没有简体中文。菜单项和标题会显示英文，不影响功能，介意的话可以在设备上
#      手动补一个 .po 再用 po2lmo 转换。
#
#    ⚠ 两个可选内核/工具开关（本配置已打开，因为都是无害的）：
#      CONFIG_BUSYBOX_CONFIG_DEVMEM   Frame Engine 计数和超频要读写硬件寄存器，
#        靠 busybox 的 devmem。不开的话页面其它部分照样能用，只是这两块变灰。
#      CONFIG_KERNEL_DEBUG_FS         PPE 流表要靠 debugfs 导出。
#        （当前注释掉了，因为它会略微增大内核。想要 PPE 表就取消注释）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
#CONFIG_KERNEL_DEBUG_FS=y


# ---------------------------------------------------------------------------
# 8. 主题
#    luci-theme-aurora 不在官方 feeds 里，由 CI 单独拉到 package/ 下。
#    它是 Vite + Tailwind 构建，编译时要在 runner 上跑 npm，
#    是整套里唯一可能在编译阶段挂掉的包。
#    如果你发现编译总在主题那步失败，可以把下面这行注释掉，
#    或者在工作流里把 aurora_theme 输入设为 false。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-aurora=y


# ---------------------------------------------------------------------------
# 9. 模块化包 (=m)
#    编译成 apk 输出到 bin/packages，但不塞进固件，可以在设备上 apk add 按需安装。
#    好处是省 rootfs 体积；代价是刷完得手动装一次。
#    这几项是沿用你上一版 .config 的选择。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_i2c-tools=m
CONFIG_PACKAGE_kmod-sched-core=m
CONFIG_PACKAGE_kmod-sched-bpf=m
CONFIG_PACKAGE_kmod-sched-flower=m
CONFIG_PACKAGE_kmod-sched-act-vlan=m


# ---------------------------------------------------------------------------
# 10. 关掉的官方包
#
#     trusted-firmware-a-an7581-bl2
#       用于生成 preloader.bin / bl31-uboot.fip 这两份 bootloader 产物。
#       但只有在 image 定义里写了 `ARTIFACTS := preloader.bin bl31-uboot.fip`
#       的设备才需要（目前只有 an7581-evb 开发板和 nokia_valyrian 这类）。
#       我们要编的 4 台都只产出 sysupgrade.itb(+recovery.itb)，不需要它。
#       关掉省一段编译时间。
#
#     u-boot-an7581_nokia_xg-040g-md
#       独立的 U-Boot 镜像包，给 Nokia MD 刷 bootloader 用（救砖场景）。
#       它不是 sysupgrade.itb 的构建依赖，4 台的 DEVICE_PACKAGES 里也没引用它。
#       如果你日后要换 bootloader 或救砖，把这行注释掉重新编译即可。
#
#     ⚠ 如果哪天编译报错说找不到 an7581-bl2.bin 或缺某个 .fip，
#       把这两行注释掉就行，不用改其它地方。
# ---------------------------------------------------------------------------
# CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2 is not set
# CONFIG_PACKAGE_u-boot-an7581_nokia_xg-040g-md is not set


# ---------------------------------------------------------------------------
# 11. 中文语言包现状
#
#    ✅ 官方 config 已经自带的（不用管，天生就有）：
#         CONFIG_LUCI_LANG_zh_Hans=y              编译时启用简体中文
#         luci-i18n-base-zh-cn                    LuCI 基础界面（菜单、按钮、状态页）
#         luci-i18n-firewall-zh-cn                防火墙页面
#         luci-i18n-package-manager-zh-cn         软件包管理页面（apk 时代的新名字）
#         luci-i18n-pon-zh-cn                     PON 页面
#
#    ✅ 本文件前面已经加上的：
#         luci-i18n-iptv-zh-cn / luci-i18n-pon-zh-cn
#         luci-i18n-filemanager-zh-cn（第 4 节）
#         luci-i18n-easytier-zh-cn（第 5 节）
#         luci-i18n-ttyd-zh-cn（第 6 节）
#
#    ❌ 没有中文的：
#         luci-app-airoha-npu —— 只有西班牙语，见第 7 节
#         主题本身通常不需要翻译（菜单文字来自各应用的语言包）
#
#    补充其它界面的中文，照这个格式加就行：
#         CONFIG_PACKAGE_luci-i18n-<包名去掉 luci-app 前缀>-zh-cn=y
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# 12. 常用软件备选区
#     这些在 ImmortalWrt 官方 packages / luci feed 里就有，不需要额外加源。
#     想要哪个就把行首的 # 删掉。
#     包管理器是 apk（不是 opkg），装删用 apk add / apk del。
# ---------------------------------------------------------------------------
