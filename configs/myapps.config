# ============================================================================
# myapps.config —— 叠加在官方 configs/an7581.config 之上的增量配置
#
#   合并命令：./scripts/kconfig.pl + configs/an7581.config configs/myapps.config > .config
#   顺序是「先官方后本文件」，本文件覆盖官方，所以这里的 "is not set" 能关掉官方的 =y。
#   官方配置随上游走，日常只需要维护这一个文件。
#
#   目标机型（airoha / an7581，共 4 台）：
#     FiberHome HG5382A        FiberHome HG5585F-CT    FiberHome HG5585F-CU
#     Nokia XG-040G-MD-UBI
#   ⚠ Nokia XG-040G-MF 是 an7583 平台，不属于本文件，要单独配一份 an7583 增量。
#
#   ★ 三条书写规则（踩过的坑）★
#   1. 关掉一个官方 =y 的项，必须写成 "# CONFIG_X is not set"。
#      写成 "#CONFIG_X=y" 只是普通注释，kconfig.pl 直接跳过，不会覆盖基线。
#   2. 本文件只放「要改的」项。基线已经是 y 的不用重复，除非要显式锁住防回退。
#   3. 行尾不能有 CRLF。kconfig.pl 的 chomp 不处理 \r，键名会带上回车符，
#      表现出来是这一行静默失效。（CI 里有 sed 兜底）
# ============================================================================


# ----------------------------------------------------------------------------
# 1. 设备选择
#    官方 an7581.config 默认勾了全部 9 台。CONFIG_TARGET_PER_DEVICE_ROOTFS=y，
#    每多一台就多打一份 rootfs，编译时间线性增长，所以不需要的逐条关掉。
# ----------------------------------------------------------------------------
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xg2010g is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_unionman_ung00a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d is not set


# ----------------------------------------------------------------------------
# 2. PON 组件 —— 这一段错了，刷完就是一块砖
#
#    airoha-pond      OMCI / OAM 协议代理，PON 注册的本体。没有它等于没网
#                     ⚠ 源码目录叫 airoha-pon-daemons，产出包名是 airoha-pond
#    airoha-ponctl    ponctl 命令行（线路配置、状态查询）
#    airoha-pon-debug 诊断数据采集
#    luci-app-pon     LuCI 页面：状态 / 配置 / 硬件身份 / 诊断
#
#    kmod-airoha-xpon         PON MAC 核心
#    kmod-airoha-pon-frontend frontend 抽象层，下面两个 kmod 的依赖
#    kmod-airoha-en7572       EN7572 光模块
#    kmod-airoha-paged-bosa   GN28L95 / UX3363 / 烽火 BOSA
#
#    ★★ 为什么两个光模块驱动都要 =y ★★
#    官方基线把它们设成 =m（只产出 apk，不进固件），但每台机器的 DTS 只匹配一个：
#      烽火三台 → airoha,paged-bosa       Nokia MD → airoha,en7572
#    =m 的话刷完 pon0 接口根本起不来，还得每台单独 apk add。
#    全 =y 多占几百 KB，换来 4 台机同一份固件刷完就能上线。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y

CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y


# ----------------------------------------------------------------------------
# 3. IPTV
#    来自 pon_userspace feed。把某个 LAN 口划给机顶盒，在 pon0 上建 802.1q 子接口。
#    ⚠ 装完默认 enabled=0，要在「网络 → IPTV」手动启用并填运营商的 IPTV VLAN ID。
#      这几个 VLAN ID 只能问运营商，填错没信号。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y


# ----------------------------------------------------------------------------
# 4. 外观 / 主题
#    luci-theme-aurora 不在官方 feeds 里，由 CI clone 到 package/。
#    它是 Vite + Tailwind 构建，编译时要在 runner 上跑 npm，是第三方包里最易挂的一环，
#    CI 有专门的「预编译失败自动剔除」步骤兜底，不会因为它拖垮主线。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-aurora=y


# ----------------------------------------------------------------------------
# 5. 系统管理
#
#    文件管理器：luci-app-filemanager（官方 luci feed，LUCI_DEPENDS 只有 +luci-base）
#      ⚠ 别换成 luci-app-quickfile：它的 DEPENDS 是 +luci-nginx，
#        会把默认 Web 服务器 uhttpd 换成 nginx，且作者自己标注「非开发人员不建议自行编译」。
#      能力：浏览/上传/下载/重命名/删除/改权限，内置十六进制编辑器，走 rpcd ACL 授权。
#      菜单：系统 → 文件管理器
#
#    网页终端：ttyd（本体）+ luci-app-ttyd（LuCI 入口）
#      自带 http 服务，不依赖 nginx。菜单：系统 → 终端
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y

CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y


# ----------------------------------------------------------------------------
# 6. SoC 状态页（NPU / CPU / Frame Engine）
#    第三方包，CI clone 自 https://github.com/luanmuc/luci-app-airoha-npu
#    LUCI_DEPENDS 只有 "+luci-base @TARGET_airoha"，零额外依赖。
#
#    能看：NPU 卸载引擎与 reserved memory、CPU 频率/温度/调度器、PPE 流表、
#          Frame Engine 端口计数、PSE 队列；还能直接写 PLL 超频（500-1600MHz）。
#    菜单：状态 → 芯片状态（自带完整简体中文，49 条，随包发布，不需要额外补翻译）
#
#    取数依赖（官方 an7581.config 基线里都已是 y，这里不重复写）：
#      CONFIG_KERNEL_DEVMEM=y            /  CONFIG_BUSYBOX_CONFIG_DEVMEM=y  → 寄存器读写
#      CONFIG_KERNEL_DEBUG_FS=y                                             → PPE 流表
#      CONFIG_BUSYBOX_CONFIG_STRINGS=y                                      → 读 NPU 固件版本号
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y


# ----------------------------------------------------------------------------
# 7. 网络功能
#
#    pbr —— 策略路由（官方 packages feed 的 net/pbr + luci feed 的 luci-app-pbr）
#      按源/目的地址、端口、域名、MAC、DSCP 分流到不同出口。
#      典型用法：只让某台机器走 EasyTier 隧道，其余走正常宽带。
#      ⚠ 装完默认 disabled，要在页面启用并指定 WAN/LAN 接口才生效。
#      resolveip 是它的依赖，基线是 is not set，这里显式打开。
#      菜单：网络 → 策略路由
#
#    UPnP —— miniupnpd 的 nftables 变体
#      ★坑：luci-app-upnp 的 DEPENDS 写的是 "+miniupnpd"，但 feeds 里没有叫 miniupnpd 的包，
#        真正提供这个 PROVIDES 的是两个互斥变体：miniupnpd-iptables / miniupnpd-nftables。
#        必须指名其中一个，否则 defconfig 因 provider 歧义选不中，页面装了也是空壳。
#      本固件防火墙是 firewall4（nftables），所以用 nftables 变体；选错会白拉一堆 kmod-ipt-*。
#      同时提供 IGD v1/v2、NAT-PMP、PCP 三种协议。
#      ⚠ 装完默认停用；UPnP 允许内网程序自行开端口，只在可信内网开。
#      菜单：服务 → UPnP
#
#    WoL —— 网络唤醒（etherwake + luci-app-wol）
#      etherwake 发二层魔术包，适合同广播域；跨网段/跨 VLAN 通常不可靠。
#      ⚠ 被唤醒机器的 BIOS 要开 WoL，且网卡关机后保持供电。
#      菜单：网络 → Wake on LAN
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y
CONFIG_PACKAGE_resolveip=y

CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y


# ----------------------------------------------------------------------------
# 8. 服务
#    vlmcsd —— 局域网 KMS 服务器，给 Windows / Office 激活用。
#      本体依赖只有 libpthread，很轻。菜单：服务 → KMS 服务器
#      ⚠ 用 TCP 1688。LAN 区默认 input=ACCEPT 所以不用放行；
#        但千万别把 1688 端口转发到 WAN。
#      客户端：slmgr /skms <路由器IP> && slmgr /ato
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y


# ----------------------------------------------------------------------------
# 9. EasyTier（异地组网 / 内网穿透）
#    第三方包，CI clone 自 https://github.com/EasyTier/luci-app-easytier
#    必须成对：easytier 是核心程序（下载预编译二进制，不本地编译，很快），
#              luci-app-easytier 是 Lua 版界面。
#
#    luci-compat 是它的依赖（LuCI 老版 Lua 兼容层）。OpenWrt 上游已删，
#    ImmortalWrt 还保留着，本固件基于 ImmortalWrt 所以可用。
#    kmod-tun 基线已是 =y，这里再写一次是防基线回退。
#
#    Web Console 是嵌入式 Web 控制台，体积不小，一般组网用不到，关掉。
#    需要就删掉下面那行。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-tun=y
# CONFIG_EASYTIER_INCLUDE_WEBCONSOLE is not set


# ----------------------------------------------------------------------------
# 10. 关掉的官方包
#
#     trusted-firmware-a-an7581-bl2
#       产出 preloader.bin / bl31-uboot.fip。只有 image 定义里写了
#       `ARTIFACTS := preloader.bin bl31-uboot.fip` 的设备才需要（an7581.mk 里
#       只有 evb 开发板、valyrian 等 5 台）。我们要编的 4 台都没写 ARTIFACTS，
#       只产出 sysupgrade.itb(+recovery.itb)，关掉省一段编译时间。
#       ⚠ 注意只关 bl2，别动 trusted-firmware-a-an7581-bl31（基线 =y，保留）。
#
#     u-boot-an7581_nokia_xg-040g-md
#       独立的 U-Boot 镜像，给 Nokia MD 刷 bootloader / 救砖用。
#       它不是 sysupgrade.itb 的构建依赖，4 台的 DEVICE_PACKAGES 里也没引用。
#       要救砖时把这行注释掉重新编译即可。
#
#     ⚠ 哪天编译报「找不到 an7581-bl2.bin 或缺某个 .fip」，把这两行注释掉就行。
# ----------------------------------------------------------------------------
# CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2 is not set
# CONFIG_PACKAGE_u-boot-an7581_nokia_xg-040g-md is not set


# ----------------------------------------------------------------------------
# 11. 模块化包 (=m)
#     编译成 apk 输出到 bin/packages，但不进固件，刷完按需 apk add。
#     好处省 rootfs 体积，代价是要手动装一次。
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_i2c-tools=m
CONFIG_PACKAGE_kmod-sched-core=m
CONFIG_PACKAGE_kmod-sched-bpf=m
CONFIG_PACKAGE_kmod-sched-flower=m
CONFIG_PACKAGE_kmod-sched-act-vlan=m


# ----------------------------------------------------------------------------
# 12. 中文语言包
#
#     CONFIG_LUCI_LANG_zh_Hans=y 在基线里已经是 y，LuCI 基础界面/防火墙/软件包/
#     PON 页面的中文也随之自带。上面各节里每个 luci-app 都配了一条
#     luci-i18n-<app>-zh-cn，那些 app 的中文都已在官方 feeds 或第三方仓库里。
#
#     以后再加别的界面，照抄这个格式即可：
#         CONFIG_PACKAGE_luci-i18n-<包名去掉 luci-app 前缀>-zh-cn=y
#     该 app 没有 zh_Hans 译文的话，这一行会被 defconfig 静默丢弃，不会报错。
# ----------------------------------------------------------------------------


# ----------------------------------------------------------------------------
# 13. 备选区
#     以下都在官方 packages / luci feed 里，不用加源。想要就把行首的 # 删掉。
#     包管理器是 apk（不是 opkg），装删用 apk add / apk del。
# ----------------------------------------------------------------------------
